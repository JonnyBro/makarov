	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^22.0.0",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.72.1",
		"eslint": "^10.14.0",
		"globals": "^17.14.0",
		"prettier": "^3.9.10",
		"prettier-eslint": "^17.1.2",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3"
